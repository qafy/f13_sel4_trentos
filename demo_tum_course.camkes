import <std_connector.camkes>;

#include "system_config.h"

//----------------------------------------------------------------------
// TimeServer
//----------------------------------------------------------------------

#include "TimeServer/camkes/TimeServer.camkes"
TimeServer_COMPONENT_DEFINE(TimeServer)

//----------------------------------------------------------------------
// Network
//----------------------------------------------------------------------

#include "plat_nic.camkes"

//----------------------------------------------------------------------
// Network Stack
//----------------------------------------------------------------------

#include "NetworkStack_PicoTcp/camkes/NetworkStack_PicoTcp.camkes"

NetworkStack_PicoTcp_COMPONENT_DEFINE(
    NetworkStack_PicoTcp,
    NIC_DRIVER_RINGBUFFER_SIZE,
    NetworkStack_PicoTcp_NO_ADDITIONAL_INTERFACES)

//----------------------------------------------------------------------
// SecureCommunication
//----------------------------------------------------------------------

#include "components/SecureCommunication/SecureCommunication.camkes"

SecureCommunication_COMPONENT_DEFINE(
    SecureCommunication
)

#ifdef USE_HW_TPM
    //----------------------------------------------------------------------
    // TPM Driver
    //----------------------------------------------------------------------

    #include "components/RPi_SPI_TPM/RPi_SPI_TPM.camkes";

    RPi_SPI_TPM_COMPONENT_DEFINE(RPi_SPI_TPM)
    RPi_SPI_TPM_HW_COMPONENT_DEFINE(RPi_SPI_TPM_HW)
#else
    //----------------------------------------------------------------------
    // EntropySource
    //----------------------------------------------------------------------

    #include "EntropySource/camkes/EntropySource.camkes"
    EntropySource_COMPONENT_DEFINE(
        EntropySource
    )
#endif

#include "components/TestApp/TestApp.camkes"

//----------------------------------------------------------------------
// System
//----------------------------------------------------------------------

assembly {
    composition {
        //----------------------------------------------------------------------
        // TimeServer
        //----------------------------------------------------------------------
        component TimeServer timeServer;

    #ifdef USE_HW_TPM
        TimeServer_INSTANCE_CONNECT_CLIENTS(
            timeServer,
            EXERCISE_DEMO_NIC_CONNECTION_TIMESERVER(nwDriver)
            nwStack.timeServer_rpc, nwStack.timeServer_notify,
            tpm.timeServer_rpc, tpm.timeServer_notify
        )
    #else
        TimeServer_INSTANCE_CONNECT_CLIENTS(
            timeServer,
            EXERCISE_DEMO_NIC_CONNECTION_TIMESERVER(nwDriver)
            nwStack.timeServer_rpc, nwStack.timeServer_notify
        )
    #endif

        //----------------------------------------------------------------------
        // Network Driver
        //----------------------------------------------------------------------
        EXERCISE_DEMO_NIC_INSTANCE(nwDriver)

        //----------------------------------------------------------------------
        // Network Stack
        //----------------------------------------------------------------------
        component NetworkStack_PicoTcp    nwStack;

        NetworkStack_PicoTcp_INSTANCE_CONNECT(
            nwStack,
            nwDriver
        )

    #ifdef USE_HW_TPM
        //----------------------------------------------------------------------
        // TPM Driver
        //----------------------------------------------------------------------
        component RPi_SPI_TPM       tpm;
        component RPi_SPI_TPM_HW    tpm_hw;

        RPi_SPI_TPM_INSTANCE_CONNECT(
            tpm,
            tpm_hw
        )
    #else
        //----------------------------------------------------------------------
        // EntropySource Component
        //----------------------------------------------------------------------
        component   EntropySource   entropySource;

        EntropySource_INSTANCE_CONNECT_CLIENT(
            entropySource,
            secureCommunication.entropy_rpc, secureCommunication.entropy_port
        )
    #endif

        //----------------------------------------------------------------------
        // SecureCommunication Component
        //----------------------------------------------------------------------
        component   SecureCommunication    secureCommunication;

        NetworkStack_PicoTcp_INSTANCE_CONNECT_CLIENTS(
            nwStack,
            secureCommunication, networkStack
        )

        //----------------------------------------------------------------------
        // Demo Component
        //----------------------------------------------------------------------
        component   TestApp      testApp;

        SecureCommunication_INSTANCE_CONNECT_CLIENTS(
            secureCommunication,
            testApp, secureCommunication
        )
    }

    configuration {
    #ifdef USE_HW_TPM
        TimeServer_CLIENT_ASSIGN_BADGES(
            EXERCISE_DEMO_NIC_TIMESERVER_CLIENTS(nwDriver)
            nwStack.timeServer_rpc,
            tpm.timeServer_rpc
        )

        RPi_SPI_TPM_HW_INSTANCE_CONFIGURE_SELF(tpm_hw)
    #else
        TimeServer_CLIENT_ASSIGN_BADGES(
            EXERCISE_DEMO_NIC_TIMESERVER_CLIENTS(nwDriver)
            nwStack.timeServer_rpc
        )
    #endif

        SecureCommunication_CLIENT_ASSIGN_BADGES(
            testApp, secureCommunication
        )

        EXERCISE_DEMO_NIC_CONFIG(nwDriver)
        
        NetworkStack_PicoTcp_CLIENT_ASSIGN_BADGES(
            secureCommunication, networkStack
        )

        NetworkStack_PicoTcp_INSTANCE_CONFIGURE_CLIENTS(
            nwStack,
            2
        )
    }
}