#pragma once

procedure if_Crypto {
    include "OS_Error.h";

    OS_Error_t generateKey();

    OS_Error_t encrypt(
        in size_t input_size,
        out size_t output_size
    );

    OS_Error_t decrypt(
        in size_t input_size,
        out size_t output_size
    );
};
