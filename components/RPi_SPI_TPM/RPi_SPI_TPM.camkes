/*
 *  RPi_SPI_TPM CAmkES Component
 *
 *  to be used as:
 *
 *      #include "NIC_RPI/NIC_RPi.camkes"
 *
 *      RPi_SPI_TPM_COMPONENT_DEFINE(RPi_SPI_TPM)
 *      RPi_SPI_TPM_HW_COMPONENT_DEFINE(RPi_SPI_TPM_HW)
 *
 * Code adapted from:
 *  - TRENTOS RPi_SPI_Flash component
 *  - TRENTOS EntropySource component
 */

#pragma once

import <std_connector.camkes>;
import <if_OS_Entropy.camkes>;

#include "interfaces/if_Crypto.camkes"
#include "interfaces/if_Keystore.camkes"

//------------------------------------------------------------------------------


// NOTE: VideoCore has this at 0x7E200000
#define RPI_SPI_TPM_HW_BCM2837_DATAPORT_PADDR     0x3F200000
#define RPI_SPI_TPM_HW_BCM2837_DATAPORT_SIZE      0x8000


//------------------------------------------------------------------------------


/*
 * Declare the RPi_SPI_TPM HW component:
 *
 *      RPi_SPI_TPM_HW_COMPONENT_DEFINE(
 *          <name>
 *      )
 */
#define RPi_SPI_TPM_HW_COMPONENT_DEFINE( \
    _name_) \
    \
    component _name_ { \
        hardware; \
        dataport  Buf(RPI_SPI_TPM_HW_BCM2837_DATAPORT_SIZE)  regBase; \
    }

/*
 * Declare the RPi_SPI_TPM driver component:
 *
 *      RPi_SPI_TPM_COMPONENT_DEFINE(
 *          <name>
 *      )
 */
#define RPi_SPI_TPM_COMPONENT_DEFINE( \
    _name_) \
    \
    component _name_ { \
        uses      if_OS_Timer                timeServer_rpc; \
        consumes  TimerReady                 timeServer_notify; \
        provides  if_OS_Entropy              entropy_rpc; \
        dataport  Buf                        entropy_port; \
        provides  if_Crypto                  crypto_rpc; \
        dataport  Buf                        crypto_port; \
        provides  if_Keystore                keystore_rpc; \
        dataport  Buf                        keystore_port; \
        dataport  Buf(RPI_SPI_TPM_HW_BCM2837_DATAPORT_SIZE)  regBase; \
    }


//------------------------------------------------------------------------------


/*
 * Connect a RPi_SPI_TPM driver instance to the HW instance.
 *
 *      RPi_SPI_TPM_INSTANCE_CONNECT(
 *          <nic>,
 *          <hw>,
 *      )
 */
#define RPi_SPI_TPM_INSTANCE_CONNECT( \
    _inst_, \
    _inst_hw_) \
    \
    connection seL4HardwareMMIO \
        _inst_ ## _mmio( \
            from _inst_.regBase, \
            to   _inst_hw_.regBase \
        );


//------------------------------------------------------------------------------


/*
 * Let RPi_SPI_TPM configure itself:
 *
 *      RPi_SPI_TPM_HW_INSTANCE_CONFIGURE_SELF(
 *          <instance>
 *      )
 */
#define RPi_SPI_TPM_HW_INSTANCE_CONFIGURE_SELF( \
    _inst_) \
    \
    _inst_.regBase_paddr  = RPI_SPI_TPM_HW_BCM2837_DATAPORT_PADDR; \
    _inst_.regBase_size   = RPI_SPI_TPM_HW_BCM2837_DATAPORT_SIZE;


//------------------------------------------------------------------------------


/*
 * Connect a client to the RPi_SPI_TPM instance via this macro:
 *
 *      RPi_SPI_TPM_INSTANCE_CONNECT_CLIENT(
 *          <instance>,
 *          <entropy>.<rpc>, <entropy>.<port>,
 *          <crypto>.<rpc>, <crypto>.<port>,
 *          <keystore>.<rpc>, <keystore>.<port>
 *      )
 *
 */
#define RPi_SPI_TPM_INSTANCE_CONNECT_CLIENT( \
    _inst_, \
    _entropy_rpc_, \
    _entropy_port_, \
    _crypto_rpc_, \
    _crypto_port_, \
    _keystore_rpc_, \
    _keystore_port_) \
    \
    connection seL4RPCCall \
        _inst_ ## _entropySource_rpc( \
            from    _entropy_rpc_, \
            to      _inst_.entropy_rpc \
        ); \
    connection seL4SharedData \
        _inst_ ## _entropySource_port( \
            from    _entropy_port_, \
            to      _inst_.entropy_port \
        ); \
    connection seL4RPCCall \
        _inst_ ## _if_Crypto_rpc( \
            from    _crypto_rpc_, \
            to      _inst_.crypto_rpc \
        ); \
    connection seL4SharedData \
        _inst_ ## _if_Crypto_port( \
            from    _crypto_port_, \
            to      _inst_.crypto_port \
        ); \
    connection seL4RPCCall \
        _inst_ ## _if_Keystore_rpc( \
            from    _keystore_rpc_, \
            to      _inst_.keystore_rpc \
        ); \
    connection seL4SharedData \
        _inst_ ## _if_Keystore_port( \
            from    _keystore_port_, \
            to      _inst_.keystore_port \
        );
